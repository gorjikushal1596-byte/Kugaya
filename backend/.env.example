# Environment Configuration for Kugaya Backend
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./kugaya.db

# AI Provider Configuration (baseten | mock | gemini | evon)
AI_PROVIDER=baseten

# Baseten — Meta Muse Spark Open Integration
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open
BASETEN_TIMEOUT_SECONDS=30.0
BASETEN_MAX_RETRIES=3

# Gnani AI Speech APIs (Prisma v2.5 STT & Timbre v2.5 TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_TTS_URL=https://api.vachana.ai/tts/v3
GNANI_MOCK_FALLBACK=False
GNANI_TIMEOUT_SECONDS=25.0
