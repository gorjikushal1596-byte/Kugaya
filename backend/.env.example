# Environment Configuration for Kugaya Backend
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./kugaya.db

# AI Provider Configuration (mock | evon | gemini)
AI_PROVIDER=mock
EVON_API_KEY=
EVON_API_BASE=https://api.evon.ai/v3.3
GEMINI_API_KEY=

# Gnani AI Speech APIs
GNANI_API_KEY=
GNANI_PRISMA_STT_URL=https://api.gnani.ai/v2.5/stt
GNANI_TIMBRE_TTS_URL=https://api.gnani.ai/v2.5/tts
GNANI_MOCK_FALLBACK=True
