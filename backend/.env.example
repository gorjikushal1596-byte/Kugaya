# ==========================================
# KUGAYA BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Environment Mode ("development" | "production")
ENVIRONMENT=production
DEBUG=False

# Persistent Database Connection
# SQLite local or persistent container volume:
DATABASE_URL=sqlite+aiosqlite:///./kugaya.db
# For container volume persistence:
# DATABASE_URL=sqlite+aiosqlite:////data/kugaya.db
# For Managed PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/kugaya

# AI Provider Selection ("baseten" | "mock")
AI_PROVIDER=baseten

# Baseten — Meta Muse Spark Open Inference
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open
BASETEN_TIMEOUT_SECONDS=30.0
BASETEN_MAX_RETRIES=3

# Gnani AI Speech-to-Text & Text-to-Speech
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_MOCK_FALLBACK=False
GNANI_TIMEOUT_SECONDS=25.0
GNANI_DEFAULT_VOICE=Nalini
MAX_AUDIO_SIZE_BYTES=26214400

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://kugaya.vercel.app,http://localhost:5173,http://127.0.0.1:5173
