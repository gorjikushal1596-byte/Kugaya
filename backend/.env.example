# Environment Configuration for Kugaya Backend
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./kugaya.db

# AI Provider Configuration (baseten | mock | gemini | evon)
AI_PROVIDER=baseten

# Baseten — Meta Muse Spark Open Integration
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open
BASETEN_TIMEOUT_SECONDS=30.0
BASETEN_MAX_RETRIES=3

# Alternative Providers
EVON_API_KEY=
EVON_API_BASE=https://api.evon.ai/v3.3
GEMINI_API_KEY=

# Gnani AI Speech APIs
GNANI_API_KEY=
GNANI_PRISMA_STT_URL=https://api.gnani.ai/v2.5/stt
GNANI_TIMBRE_TTS_URL=https://api.gnani.ai/v2.5/tts
GNANI_MOCK_FALLBACK=True
